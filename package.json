{
  "name": "clear-path-monorepo",
  "version": "1.0.4",
  "description": "Clear Path — Full Build (Web + Electron)",
  "main": "electron/main.js",
  "scripts": {
    "server": "cd server_py && py -3 main.py",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "electron": "electron .",
    "electron:dev": "node -e \"process.env.NODE_ENV='development'; require('child_process').spawn('electron', ['.'], {stdio:'inherit'})\"",
    "build": "cd client && npm run build",
    "build:vercel": "cd client && npm install --include=dev && npm run build",
    "install-all": "npm install && cd client && npm install",
    "electron:build": "npm run build && electron-builder build --windows"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.huellaverde.clearpath",
    "productName": "ClearPath",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "server_py/dist/clearpath_server.exe",
      "server_py/.env",
      "database/**/*",
      "!database/*.log",
      "client/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server_py/dist/clearpath_server.exe",
        "to": "server_py/dist/clearpath_server.exe"
      },
      {
        "from": "server_py/.env",
        "to": "server_py/.env"
      },
      {
        "from": "database/",
        "to": "database/",
        "filter": ["**/*", "!*.log"]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "client/public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClearPath Jud",
      "installerIcon": "client/public/logo.ico",
      "uninstallerIcon": "client/public/logo.ico",
      "artifactName": "${productName}_Setup_${version}.${ext}"
    }
  }
}
