{
  "name": "clear-path-monorepo",
  "version": "1.0.0",
  "description": "Clear Path — Full Build (Web + Electron)",
  "main": "electron/main.js",
  "scripts": {
    "server": "cd server_py && py -3 main.py",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "electron": "electron .",
    "electron:dev": "node -e \"process.env.NODE_ENV='development'; require('child_process').spawn('electron', ['.'], {stdio:'inherit'})\"",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "electron:build": "npm run build && electron-builder build --windows"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.huellaverde.clearpath",
    "productName": "ClearPath",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "server_py/**/*",
      "!server_py/venv${/*}",
      "!server_py/__pycache__${/*}",
      "!server_py/scripts${/*}",
      "database/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "client/public/logo.png"
    }
  }
}
